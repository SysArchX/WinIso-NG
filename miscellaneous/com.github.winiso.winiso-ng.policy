<?xml version="1.0" ?><!DOCTYPE policyconfig  PUBLIC '-//freedesktop//DTD polkit Policy Configuration 1.0//EN'  'http://www.freedesktop.org/software/polkit/policyconfig-1.dtd'><!-- 
DOC: https://www.freedesktop.org/software/polkit/docs/latest/polkit.8.html
--><policyconfig>
	<vendor>The WinIso Project</vendor>
	<vendor_url>https://github.com/WinIso/WinIso-NG</vendor_url>
	<icon_name>winiso-icon</icon_name>

	<action id="com.github.winiso.winiso-ng.run-gui-using-pkexec">
		<description>Run `winiso` as SuperUser</description>
		<description xml:lang="zh_TW">以超級使用者(SuperUser)身份執行 `winiso`</description>
		<description xml:lang="pl_PL">Uruchom `winiso` jako root</description>
		<description xml:lang="pt_BR">Execute `winiso` como root</description>
		
		<message>Authentication is required to run `winiso` as SuperUser.</message>
		<message xml:lang="zh_TW">以超級使用者(SuperUser)身份執行 `winiso` 需要通過身份驗證。</message>
		<message xml:lang="pl_PL">Wymagana jest autoryzacja do uruchomienia `winiso` jako root</message>
        <message xml:lang="pt_BR">A autenticação é necessária para executar `winiso` como root.</message>
		
		<defaults>
			<allow_any>auth_admin</allow_any>
			<allow_inactive>auth_admin</allow_inactive>
			<allow_active>auth_admin_keep</allow_active>
		</defaults>
		
		<annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/winisogui</annotate>
   		<annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
	</action>
</policyconfig>
